{
  "expo": {
    "name": "Bolty",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bolty",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.utilityanalyzer.irxvru",
      "infoPlist": {
        "NSCameraUsageDescription": "Scatta una foto della tua bolletta da analizzare",
        "NSPhotoLibraryUsageDescription": "Carica la foto della bolletta dalla galleria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#16213E"
      },
      "package": "com.emergent.utilityanalyzer.irxvru",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5EF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Carica la foto della bolletta dalla galleria",
          "cameraPermission": "Scatta una foto della tua bolletta da analizzare"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
